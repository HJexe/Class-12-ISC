# Optional Admin Passkey for the Owner-Only Notes Uploader Studio (#admin-upload or Ctrl+Shift+U)
ADMIN_PASSKEY=

# Optional GitHub Personal Access Token & Repository (owner/repo) for automatic GitHub/Vercel sync
GITHUB_TOKEN=
GITHUB_REPO=

# Optional Google Drive API Key (zero-key public link & folder recognition is enabled by default)
GOOGLE_DRIVE_API_KEY=
